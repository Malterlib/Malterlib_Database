Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Database}"
{
	Property.MalterlibConcurrency_DistributedActors true

	%Group "Database"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Database/^*"
		}
		%File "Source/^*"
		%Group "Database"
		{
			%File "Source/Database/*.cpp"
			{
				Compile.Disabled true
				{
					!Documentation undefined
				}
			}
			%File "Source/Database/*IDList.*"
			{
				Compile.Disabled true
				{
					!Documentation undefined
				}
			}
			%File "Source/Database/*Internal.h"
			{
				Compile.Disabled true
				{
					!Documentation undefined
				}
			}
		}
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Database define bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Database"
	{
		!!MalterlibLibrary_Database true
	}
	MalterlibLibrarySeparate_Lib_Malterlib_Database define bool = true
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Database define bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Database true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Database"
	MalterlibTestFiles_Malterlib_Database define [type(CEntity)] = ["Test/*"->MakeAbsolute()]
	MalterlibTestDependencies_Malterlib_Database define [type(CEntity)] = ["Lib_Malterlib_Database"]
}
